{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freehold Ledger",
  "version": "1.0.0",
  "identifier": "org.freeholders.ledger",
  "build": {
    "beforeDevCommand": "bash ../scripts/build-sidecar.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash ../scripts/build-sidecar.sh ${TAURI_ENV_TARGET_TRIPLE:-} && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Freehold Ledger",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/ledger-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
